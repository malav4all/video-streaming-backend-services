DB_SSLMODE_PROD=require
DB_MAX_OPEN_CONNS_PROD=100
DB_MAX_IDLE_CONNS_PROD=25

# ============================================================================
# JWT CONFIGURATION - Per Environment
# (for future auth module — not yet wired into the codebase)
# ============================================================================
JWT_SECRET_LOCAL=change-this-local-dev-secret-key-minimum-32-characters
JWT_EXPIRATION_LOCAL=24h

JWT_SECRET_DEV=change-this-dev-secret-key-minimum-32-characters
JWT_EXPIRATION_DEV=24h

JWT_SECRET_UAT=change-this-uat-secret-key-minimum-32-characters
JWT_EXPIRATION_UAT=1h

JWT_SECRET_PROD=change-this-prod-secret-key-minimum-32-characters
JWT_EXPIRATION_PROD=15m

