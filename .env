# ============================================================================
# REDIS CONFIGURATION - Per Environment
# (used for OAuth2 state + session storage)
# ============================================================================
REDIS_HOST_LOCAL=localhost
REDIS_PORT_LOCAL=6379
REDIS_USERNAME_LOCAL=
REDIS_PASSWORD_LOCAL=
REDIS_DB_LOCAL=0
SESSION_TTL_LOCAL=24h

REDIS_HOST_DEV=dev-redis.internal
REDIS_PORT_DEV=6379
REDIS_USERNAME_DEV=
REDIS_PASSWORD_DEV=changeme
REDIS_DB_DEV=0
SESSION_TTL_DEV=24h

REDIS_HOST_UAT=uat-redis.internal
REDIS_PORT_UAT=6379
REDIS_USERNAME_UAT=
REDIS_PASSWORD_UAT=changeme
REDIS_DB_UAT=0
SESSION_TTL_UAT=8h

REDIS_HOST_PROD=prod-redis.internal
REDIS_PORT_PROD=6379
REDIS_USERNAME_PROD=
REDIS_PASSWORD_PROD=changeme
REDIS_DB_PROD=0
SESSION_TTL_PROD=1h

# ============================================================================
# SECURITY CONFIGURATION - Per Environment
# ============================================================================
# Local (most relaxed)
RATE_LIMIT_PER_MINUTE_LOCAL=2000
MAX_REQUEST_SIZE_LOCAL=104857600
REQUEST_TIMEOUT_LOCAL=120s

# Development
RATE_LIMIT_PER_MINUTE_DEV=1000
MAX_REQUEST_SIZE_DEV=104857600
REQUEST_TIMEOUT_DEV=60s

# UAT
RATE_LIMIT_PER_MINUTE_UAT=200
MAX_REQUEST_SIZE_UAT=52428800
REQUEST_TIMEOUT_UAT=45s

# Production (strictest)
RATE_LIMIT_PER_MINUTE_PROD=100
MAX_REQUEST_SIZE_PROD=33554432
REQUEST_TIMEOUT_PROD=30s

# ============================================================================
# CORS CONFIGURATION - Per Environment
# ============================================================================
ALLOWED_ORIGINS_LOCAL=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS_LOCAL=true

ALLOWED_ORIGINS_DEV=https://dev.example.com,http://localhost:3000
CORS_ALLOW_CREDENTIALS_DEV=true

ALLOWED_ORIGINS_UAT=https://uat.example.com
CORS_ALLOW_CREDENTIALS_UAT=true

ALLOWED_ORIGINS_PROD=https://example.com
CORS_ALLOW_CREDENTIALS_PROD=false

# ============================================================================
# SECURITY FEATURE TOGGLES (common across environments)
# ============================================================================
ENABLE_SECURITY_HEADERS=true
ENABLE_INPUT_VALIDATION=true
ENABLE_SECURE_LOGGING=true