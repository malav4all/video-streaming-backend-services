# ============================================================================
# ENVIRONMENT
# ============================================================================
# APP_ENV=development
# APP_ENV=uat
# APP_ENV=production
APP_ENV=local

LOG_LEVEL=info
PORT=8080

# ============================================================================
# DATABASE CONFIGURATION - Per Environment
# ============================================================================
# Local
DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=5432
DB_USER_LOCAL=malav
DB_PASSWORD_LOCAL=
DB_NAME_LOCAL=postgres
DB_SSLMODE_LOCAL=disable
DB_MAX_OPEN_CONNS_LOCAL=25
DB_MAX_IDLE_CONNS_LOCAL=10

# Development
DB_HOST_DEV=dev-db.internal
DB_PORT_DEV=5432
DB_USER_DEV=app_user
DB_PASSWORD_DEV=changeme
DB_NAME_DEV=userdb_dev
DB_SSLMODE_DEV=disable
DB_MAX_OPEN_CONNS_DEV=25
DB_MAX_IDLE_CONNS_DEV=10

# UAT
DB_HOST_UAT=uat-db.internal
DB_PORT_UAT=5432
DB_USER_UAT=app_user
DB_PASSWORD_UAT=changeme
DB_NAME_UAT=userdb_uat
DB_SSLMODE_UAT=require
DB_MAX_OPEN_CONNS_UAT=50
DB_MAX_IDLE_CONNS_UAT=15

# Production
DB_HOST_PROD=prod-db.internal
DB_PORT_PROD=5432
DB_USER_PROD=app_user
DB_PASSWORD_PROD=changeme
DB_NAME_PROD=userdb_prod
DB_SSLMODE_PROD=require
DB_MAX_OPEN_CONNS_PROD=100
DB_MAX_IDLE_CONNS_PROD=25

# ============================================================================
# JWT CONFIGURATION - Per Environment
# (for future auth module — not yet wired into the codebase)
# ============================================================================
JWT_SECRET_LOCAL=change-this-local-dev-secret-key-minimum-32-characters
JWT_EXPIRATION_LOCAL=24h

JWT_SECRET_DEV=change-this-dev-secret-key-minimum-32-characters
JWT_EXPIRATION_DEV=24h

JWT_SECRET_UAT=change-this-uat-secret-key-minimum-32-characters
JWT_EXPIRATION_UAT=1h

JWT_SECRET_PROD=change-this-prod-secret-key-minimum-32-characters
JWT_EXPIRATION_PROD=15m

# ============================================================================
# SECURITY CONFIGURATION - Per Environment
# ============================================================================
# Local (most relaxed)
RATE_LIMIT_PER_MINUTE_LOCAL=2000
MAX_REQUEST_SIZE_LOCAL=104857600
REQUEST_TIMEOUT_LOCAL=120s

# Development
RATE_LIMIT_PER_MINUTE_DEV=1000
MAX_REQUEST_SIZE_DEV=104857600
REQUEST_TIMEOUT_DEV=60s

# UAT
RATE_LIMIT_PER_MINUTE_UAT=200
MAX_REQUEST_SIZE_UAT=52428800
REQUEST_TIMEOUT_UAT=45s

# Production (strictest)
RATE_LIMIT_PER_MINUTE_PROD=100
MAX_REQUEST_SIZE_PROD=33554432
REQUEST_TIMEOUT_PROD=30s

# ============================================================================
# CORS CONFIGURATION - Per Environment
# ============================================================================
ALLOWED_ORIGINS_LOCAL=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS_LOCAL=true

ALLOWED_ORIGINS_DEV=https://dev.example.com,http://localhost:3000
CORS_ALLOW_CREDENTIALS_DEV=true

ALLOWED_ORIGINS_UAT=https://uat.example.com
CORS_ALLOW_CREDENTIALS_UAT=true

ALLOWED_ORIGINS_PROD=https://example.com
CORS_ALLOW_CREDENTIALS_PROD=false

# ============================================================================
# SECURITY FEATURE TOGGLES (common across environments)
# ============================================================================
ENABLE_SECURITY_HEADERS=true
ENABLE_INPUT_VALIDATION=true
ENABLE_SECURE_LOGGING=true