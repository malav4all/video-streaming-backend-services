# ============================================================================
# ENVIRONMENT
# ============================================================================
# APP_ENV=local
# APP_ENV=development
# APP_ENV=uat
# APP_ENV=production
APP_ENV=local

LOG_LEVEL=info
PORT=8081

# ============================================================================
# DATABASE CONFIGURATION - Per Environment
# ============================================================================
# Local
# DB_HOST_LOCAL=localhost
# DB_PORT_LOCAL=5432
# DB_USER_LOCAL=postgres
# DB_PASSWORD_LOCAL=postgres
# DB_NAME_LOCAL=userdb
# DB_SSLMODE_LOCAL=disable
# DB_MAX_OPEN_CONNS_LOCAL=25
# DB_MAX_IDLE_CONNS_LOCAL=10


DB_HOST_LOCAL=ep-old-king-azx07v50-pooler.c-3.ap-southeast-1.aws.neon.tech
DB_PORT_LOCAL=5432
DB_USER_LOCAL=neondb_owner
DB_PASSWORD_LOCAL=npg_OQ4Xywe6HPNJ
DB_NAME_LOCAL=neondb
DB_SSLMODE_LOCAL=require
DB_MAX_OPEN_CONNS_LOCAL=25
DB_MAX_IDLE_CONNS_LOCAL=10

# Development
DB_HOST_DEV=dev-db.internal
